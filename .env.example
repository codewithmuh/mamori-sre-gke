# Copy to .env (gitignored) and fill in. `make` reads this file, so write plain KEY=value lines:
# no quotes, no `export`, no comment after a value. Non-empty variables in your shell and the make
# command line (`make up PROJECT_ID=...`) override what is here. No secrets: Terraform and gcloud
# use your own login (`gcloud auth login` and `gcloud auth application-default login`).

# Google Cloud project for the lab, e.g. mamori-lab-123456.
PROJECT_ID=

# Zone of the zonal GKE cluster.
ZONE=asia-northeast1-a

# Terraform state bucket that `make bootstrap` creates. Empty means ${PROJECT_ID}-tfstate.
TF_STATE_BUCKET=

# Public hostname of the shop. Its DNS records are added by hand where codewithmuh.com is hosted.
FRONTEND_HOSTNAME=mamori.codewithmuh.com

# Billing account for the budget, e.g. 012345-6789AB-CDEF01 (`gcloud billing accounts list`).
BILLING_ACCOUNT_ID=
