{
  "name": "mamori-sre-gke",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/terraform:1.5.1": {
      "version": "1.17.1",
      "tflint": "0.65.0",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/go:1.4.1": { "version": "1.27.3", "golangciLintVersion": "2.15.0" },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1.3.2": {
      "version": "1.37.2",
      "helm": "4.3.1",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": { "version": "2.103.0" }
  },
  "postCreateCommand": "pre-commit install",
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "golang.go",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "timonwong.shellcheck",
        "github.vscode-github-actions",
        "editorconfig.editorconfig"
      ]
    }
  }
}
